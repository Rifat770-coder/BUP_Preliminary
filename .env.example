# Application environment.
# - "dev" (default) / "development": permissive; mock provider allowed.
# - "production" / "prod": strict; refuses to boot if LLM_PROVIDER=mock
#   or if LLM_API_KEY / LLM_MODEL / LLM_BASE_URL (when required) are missing.
APP_ENV=dev

# LLM provider configuration.
# Supported providers: openai_compatible | openai | groq | gemini | mock
# In production, "mock" is rejected at startup.
LLM_PROVIDER=mock

# API key for the chosen provider (NEVER commit a real key).
LLM_API_KEY=

# Model identifier (depends on provider). Required in production.
LLM_MODEL=

# Base URL for openai_compatible providers. Required for that provider in production.
LLM_BASE_URL=

# LLM request timeout in seconds.
LLM_TIMEOUT_SECONDS=12

# Application host/port.
HOST=0.0.0.0
PORT=8000


APP_ENV=dev

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=YOUR_MODEL_NAME

LLM_TIMEOUT_SECONDS=12

HOST=0.0.0.0
PORT=8000